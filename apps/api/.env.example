# MAYA API — environment
NODE_ENV=development
PORT=3000

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:8081"]

# Supabase (Postgres + Auth + Storage + Realtime) — Phase 2 wiring
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Cloud Messaging — Phase 2 wiring
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI providers (custom OpenAI-compatible)
# Primary vision/extraction provider
AI_VISION_PROVIDER=shiteru
AI_VISION_BASE_URL=https://shiteru.id/v1
AI_VISION_API_KEY=            # or use AI_VISION_KEY_ENV
AI_VISION_KEY_ENV=HERMES_CUSTOM_SHITERU_API_KEY
AI_VISION_MODEL=deepseek-v4-pro

# Fallback provider
AI_FALLBACK_PROVIDER=surplus
AI_FALLBACK_BASE_URL=https://api.surplusintelligence.ai/v1/
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=deepseek-v4-flash