{
  "name": "maya-transparency-hub",
  "version": "0.1.0",
  "private": true,
  "description": "MAYA - Manage All Your Assets. Family transparency hub (finance + inventory + goals + coordination).",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@nestjs/core"
    ]
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "build": "pnpm build:packages && pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "eslint": "^9.13.0"
  }
}